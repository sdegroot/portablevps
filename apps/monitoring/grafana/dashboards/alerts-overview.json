{
  "uid": "alerts-overview",
  "title": "Alerts — Overview",
  "description": "Live + historical alert state. Backed by the ALERTS series vmalert writes into VictoriaMetrics (-remoteWrite). The Alertmanager UI (alerts.apps.example.int) is the place to silence/ack; this is the at-a-glance board. COPIED, not Jinja-rendered ({{ ... }} is Grafana templating).",
  "tags": ["monitoring", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Firing now",
      "type": "stat",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Pending",
      "type": "stat",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "count(ALERTS{alertstate=\"pending\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Firing by severity",
      "type": "piechart",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "right", "values": ["value"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\"})",
          "instant": true,
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active alerts",
      "type": "table",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "severity" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "critical": { "color": "red", "index": 0 }, "warning": { "color": "yellow", "index": 1 } } } ] } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "severity", "desc": true } ] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true }, "indexByName": { "alertname": 0, "severity": 1, "host_name": 2, "mountpoint": 3, "instance": 4 } } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Firing alerts over time",
      "type": "timeseries",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineInterpolation": "stepAfter" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
          "expr": "sum by (alertname) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}"
        }
      ]
    }
  ]
}
